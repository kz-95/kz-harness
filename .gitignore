# Every dotfile and dot-folder is machine-local: .env, .omc, .claude, .vscode, .idea ...
# Keys live in ~/.dsh/.env, outside this repo, and must never be committed.
.*
!.gitignore

node_modules/
*.log
*.bak
*.bak-*
*.tmp

# Local chat space for the "No project" workspace
no-project/

# Built app (npm run package in app/)
app/dist/

# Windows shortcuts
*.lnk
