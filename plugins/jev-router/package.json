{
  "name": "jev-router",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: Jev routes tasks to Claude Code, Codex, DeepSeek, API-key agents or a tool, and adds the Jev inspector tab and setup page.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "@typesafe-ai/sdk": "0.6.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
